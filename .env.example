# Copiá este archivo a .env y completá con los valores reales (nunca commitear .env)

# URL base del WordPress headless (sin barra final), ej: https://admin.andradsalud.com.ar
VITE_WP_API_BASE=

# ID numérico del formulario de Contact Form 7 usado para inscripciones
VITE_CF7_FORM_ID=

# En Vercel: configurar estos mismos nombres en Project Settings → Environment Variables.
# Cualquier variable VITE_* queda expuesta en el bundle del navegador (es pública),
# así que nunca poner acá credenciales, tokens ni claves secretas.
